pkgname=miltop
pkgver=1.3.0
pkgrel=1
pkgdesc="Lightweight tile-based terminal system monitor"
arch=('any')
url="https://github.com/milosz-1710/miltop"
license=('GPL-3.0-or-later')
depends=('python' 'python-psutil')
optdepends=('inxi: detailed RAM hardware identification'
            'nvidia-utils: NVIDIA GPU metrics')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/milosz-1710/miltop/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dpm0755 miltop.py "${pkgdir}/usr/bin/miltop"
  install -Dpm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dpm0644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dpm0644 CHANGELOG.md "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
}
